# =====================================================================
# Hermes Cloud Backup - example configuration
# ---------------------------------------------------------------------
# Copy this file to backup.env and edit to taste:
#     cp backup.env.example backup.env
# NEVER put real secrets (rclone crypt password, OAuth token) here.
# They live in rclone.conf (mode 600), which this script reads in-place.
# This file must contain NO secrets.
# =====================================================================

# --- Source (Hermes home; auto-detected if blank) -------------------
# Leave blank to use $HERMES_HOME or $HOME/.hermes
HERMES_HOME_OVERRIDE=""

# --- rclone remotes (defined in ~/.config/rclone/rclone.conf) -------
# Plaintext remote pointing at the dedicated backup location (no encryption):
#   gdrive-hermes:HermesBackups/       (Google Drive, scope=drive.file)
PLAINTEXT_REMOTE="gdrive-hermes:HermesBackups/"

# --- Retention ------------------------------------------------------
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6

# --- Local staging --------------------------------------------------
# Where the temporary local zip lives before upload + verification.
# Deleted only after a SUCCESSFUL upload+verify. Kept on failure for retry.
LOCAL_STAGING_DIR=""

# --- Logging --------------------------------------------------------
# Logs are written here. Logs NEVER contain secrets.
LOG_DIR=""

# --- Misc -----------------------------------------------------------
# Dry-run by default? Set to "yes" to make every run a dry run unless
# --backup / --no-dry-run is passed.
DEFAULT_DRY_RUN="no"

# Health threshold: warn if free disk space (MB) drops below this.
MIN_FREE_MB=512
