[Unit]
Description=Hermes Agent cloud backup (rclone -> Google Drive)
Documentation=https://github.com/HaoNgo232/hermes-backup#readme
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory="@REPO_DIR@"
Environment="HERMES_HOME=@HERMES_HOME@"
Environment="HERMES_BIN=@HERMES_BIN@"
Environment="XDG_CONFIG_HOME=@XDG_CONFIG_HOME@"
Environment="PATH=@PATH@"
ExecStart="@REPO_DIR@/backup.sh"
Nice=10
IOSchedulingClass=idle
