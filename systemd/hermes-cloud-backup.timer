[Unit]
Description=Hermes cloud backup timer (every four hours)
Documentation=file://@REPO_DIR@/README.md

[Timer]
# Schedule: 02:00, 06:00, 10:00, 14:00, 18:00, 22:00
# RandomizedDelaySec means actual start may be up to 5 min after the hour
OnCalendar=*-*-* 02,06,10,14,18,22:00:00
# Run missed backups when user manager becomes active again
# (requires loginctl enable-linger for operation after logout/reboot)
Persistent=true
RandomizedDelaySec=5min
Unit=hermes-cloud-backup.service

[Install]
WantedBy=timers.target
