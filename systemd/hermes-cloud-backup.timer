[Unit]
Description=Hermes cloud backup timer (every four hours)
Documentation=%h/hermes-backup/README.md

[Timer]
# Run every four hours: 02:00, 06:00, 10:00, 14:00, 18:00, and 22:00
OnCalendar=*-*-* 02,06,10,14,18,22:00:00
# Run a missed backup after the machine is started again
Persistent=true
RandomizedDelaySec=5min
Unit=hermes-cloud-backup.service

[Install]
WantedBy=timers.target
